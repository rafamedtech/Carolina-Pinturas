generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AppUser {
  userId    String   @id @map("user_id") @db.Uuid
  email     String   @unique
  name      String
  role      String   @default("vendedor") @db.VarChar(32)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  repartidor    Repartidor?
  expenses      Expense[]
  productImages ProductImage[]

  @@index([role, active])
  @@map("app_users")
}

model OrderStatus {
  key        String   @id @db.VarChar(32)
  label      String   @db.VarChar(64)
  sortOrder  Int      @unique @map("sort_order")
  color      String   @default("neutral") @db.VarChar(24)
  isTerminal Boolean  @default(false) @map("is_terminal")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders      SalesOrder[]
  historyFrom SalesOrderStatusHistory[] @relation("status_history_from")
  historyTo   SalesOrderStatusHistory[] @relation("status_history_to")

  @@map("order_statuses")
}

model Repartidor {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?  @unique(map: "repartidores_user_id_key") @map("user_id") @db.Uuid
  nombre      String
  telefono    String?
  activo      Boolean  @default(true)
  esMostrador Boolean  @default(false) @map("es_mostrador")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  appUser AppUser?     @relation(fields: [userId], references: [userId], onDelete: SetNull, onUpdate: NoAction)
  orders  SalesOrder[]

  @@index([nombre])
  @@map("repartidores")
}

model SiigoProduct {
  id                String    @id @db.Uuid
  code              String    @db.VarChar(100)
  name              String
  accountGroupId    Int?      @map("account_group_id")
  accountGroupName  String?   @map("account_group_name")
  type              String?   @db.VarChar(64)
  stockControl      Boolean?  @map("stock_control")
  active            Boolean?
  taxIncluded       Boolean?  @map("tax_included")
  unitCode          String?   @map("unit_code") @db.VarChar(32)
  unitName          String?   @map("unit_name")
  keyCode           String?   @map("key_code") @db.VarChar(32)
  keyName           String?   @map("key_name")
  reference         String?
  description       String?
  barcode           String?
  brand             String?
  initialUnitCost   Decimal?  @map("initial_unit_cost") @db.Decimal(20, 6)
  initialCostCurrency String? @map("initial_cost_currency") @db.VarChar(3)
  unitCost          Decimal?  @map("unit_cost") @db.Decimal(20, 6)
  costCurrency      String?   @map("cost_currency") @db.VarChar(3)
  availableQuantity Decimal?  @map("available_quantity") @db.Decimal(20, 6)
  siigoCreatedAt    DateTime? @map("siigo_created_at") @db.Timestamptz(6)
  siigoUpdatedAt    DateTime? @map("siigo_updated_at") @db.Timestamptz(6)
  rawPayload        Json      @map("raw_payload") @db.JsonB
  syncedAt          DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  prices     SiigoProductPrice[]
  taxes      SiigoProductTax[]
  warehouses SiigoProductWarehouse[]
  components SiigoProductComponent[]
  inventoryProduct InventoryProduct?
  inventoryBalances InventoryBalance[]
  inventoryReservations InventoryReservation[]
  inventoryLines InventoryMovementLine[]
  inventoryCountLines InventoryCountLine[]
  orderItems SalesOrderItem[]
  purchaseItems PurchaseItem[]

  @@index([code])
  @@index([name])
  @@map("siigo_products")
}

model SiigoProductPrice {
  id           BigInt  @id @default(autoincrement())
  productId    String  @map("product_id") @db.Uuid
  currencyCode String  @map("currency_code") @db.VarChar(3)
  position     Int
  name         String?
  value        Decimal @db.Decimal(20, 6)
  rawPayload   Json    @map("raw_payload") @db.JsonB

  product SiigoProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, currencyCode, position])
  @@map("siigo_product_prices")
}

model SiigoProductTax {
  productId  String   @map("product_id") @db.Uuid
  siigoTaxId Int      @map("siigo_tax_id")
  name       String?
  type       String?  @db.VarChar(32)
  percentage Decimal? @db.Decimal(9, 6)
  rawPayload Json     @map("raw_payload") @db.JsonB

  product SiigoProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, siigoTaxId])
  @@map("siigo_product_taxes")
}

model SiigoProductWarehouse {
  productId        String   @map("product_id") @db.Uuid
  siigoWarehouseId Int      @map("siigo_warehouse_id")
  name             String?
  quantity         Decimal? @db.Decimal(20, 6)
  rawPayload       Json     @map("raw_payload") @db.JsonB

  product SiigoProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, siigoWarehouseId])
  @@map("siigo_product_warehouses")
}

model SiigoProductComponent {
  id               BigInt   @id @default(autoincrement())
  productId        String   @map("product_id") @db.Uuid
  siigoComponentId String?  @map("siigo_component_id")
  name             String?
  quantity         Decimal? @db.Decimal(20, 6)
  rawPayload       Json     @map("raw_payload") @db.JsonB

  product SiigoProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("siigo_product_components")
}

model SiigoCustomer {
  id                    String    @id @db.Uuid
  name                  Json      @db.JsonB
  displayName           String    @map("display_name")
  commercialName        String?   @map("commercial_name")
  branchOffice          Int?      @map("branch_office")
  personType            String?   @map("person_type") @db.VarChar(32)
  type                  String?   @db.VarChar(32)
  isCustomer            Boolean   @default(false) @map("is_customer")
  isSupplier            Boolean   @default(false) @map("is_supplier")
  isInternalOrderCustomer Boolean @default(false) @map("is_internal_order_customer")
  identification        String?
  rfcId                 String?   @map("rfc_id")
  fiscalRegime          String?   @map("fiscal_regime")
  active                Boolean?
  comments              String?
  sellerId              Int?      @map("seller_id")
  collectorId           Int?      @map("collector_id")
  siigoCreatedAt        DateTime? @map("siigo_created_at") @db.Timestamptz(6)
  siigoUpdatedAt        DateTime? @map("siigo_updated_at") @db.Timestamptz(6)
  internalCode          String?   @unique(map: "siigo_customers_internal_code_key") @map("internal_code") @db.VarChar(64)
  internalNotes         String?   @map("internal_notes")
  internalTags          String[]  @default([]) @map("internal_tags")
  requiresInvoice       Boolean   @default(false) @map("requires_invoice")
  syncStatus            String    @default("synced") @map("sync_status") @db.VarChar(16)
  lastSyncError         String?   @map("last_sync_error")
  syncVersion           Int       @default(1) @map("sync_version")
  createdByEmail        String?   @map("created_by_email")
  updatedByEmail        String?   @map("updated_by_email")
  rawPayload            Json      @map("raw_payload") @db.JsonB
  syncedAt              DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  phones   SiigoCustomerPhone[]
  contacts SiigoCustomerContact[]
  orders   SalesOrder[]
  expenses Expense[]
  purchases PurchaseOrder[]

  @@index([displayName])
  @@index([rfcId])
  @@index([rfcId, branchOffice], map: "siigo_customers_rfc_branch_office_idx")
  @@index([isCustomer, active], map: "siigo_customers_is_customer_active_idx")
  @@index([isSupplier, active], map: "siigo_customers_is_supplier_active_idx")
  @@index([isInternalOrderCustomer, active], map: "siigo_customers_internal_order_customer_idx")
  @@index([syncStatus, syncedAt], map: "siigo_customers_sync_status_idx")
  @@map("siigo_customers")
}

model SiigoCustomerPhone {
  id         BigInt  @id @default(autoincrement())
  customerId String  @map("customer_id") @db.Uuid
  position   Int
  indicative String? @db.VarChar(10)
  number     String?
  extension  String? @db.VarChar(10)
  rawPayload Json    @map("raw_payload") @db.JsonB

  customer SiigoCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, position])
  @@map("siigo_customer_phones")
}

model SiigoCustomerContact {
  id              BigInt  @id @default(autoincrement())
  customerId      String  @map("customer_id") @db.Uuid
  position        Int
  firstName       String? @map("first_name")
  lastName        String? @map("last_name")
  email           String?
  phone           String?
  phoneIndicative String? @map("phone_indicative") @db.VarChar(10)
  phoneExtension  String? @map("phone_extension") @db.VarChar(10)
  rawPayload      Json    @map("raw_payload") @db.JsonB

  customer SiigoCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, position])
  @@map("siigo_customer_contacts")
}

model SalesOrder {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  folio                      Int       @unique @default(autoincrement())
  statusKey                  String    @default("borrador") @map("status_key") @db.VarChar(32)
  customerId                 String    @map("customer_id") @db.Uuid
  customerNameSnapshot       String    @map("customer_name_snapshot")
  customerRfcSnapshot        String?   @map("customer_rfc_snapshot")
  customerPayload            Json      @map("customer_payload") @db.JsonB
  orderDate                  DateTime  @default(dbgenerated("CURRENT_DATE")) @map("order_date") @db.Date
  promisedDate               DateTime? @map("promised_date") @db.Date
  observations               String?
  remision                   String?
  requiresInvoice            Boolean   @default(false) @map("requires_invoice")
  tags                       String[]  @default([])
  currencyCode               String    @default("MXN") @map("currency_code") @db.VarChar(3)
  paymentStatus              String    @default("pendiente_pago") @map("payment_status") @db.VarChar(32)
  paymentMethod              String?   @map("payment_method") @db.VarChar(32)
  paymentDate                DateTime? @map("payment_date") @db.Date
  subtotal                   Decimal   @default(0) @db.Decimal(20, 6)
  discountType               String    @default("porcentaje") @map("discount_type") @db.VarChar(16)
  discountValue              Decimal   @default(0) @map("discount_value") @db.Decimal(20, 6)
  discountAmount             Decimal   @default(0) @map("discount_amount") @db.Decimal(20, 6)
  discountTotal              Decimal   @default(0) @map("discount_total") @db.Decimal(20, 6)
  taxTotal                   Decimal   @default(0) @map("tax_total") @db.Decimal(20, 6)
  total                      Decimal   @default(0) @db.Decimal(20, 6)
  siigoReference             String?   @map("siigo_reference")
  registeredInSiigoAt        DateTime? @map("registered_in_siigo_at") @db.Timestamptz(6)
  vendedorNombre             String    @map("vendedor_nombre")
  vendedorEmail              String    @map("vendedor_email")
  repartidorId               String?   @map("repartidor_id") @db.Uuid
  repartidorNombreSnapshot   String?   @map("repartidor_nombre_snapshot")
  repartidorTelefonoSnapshot String?   @map("repartidor_telefono_snapshot")
  createdByName              String    @map("created_by_name")
  createdByEmail             String    @map("created_by_email")
  createdByRole              String    @map("created_by_role") @db.VarChar(32)
  updatedByEmail             String    @map("updated_by_email")
  warehouseId                String? @map("warehouse_id") @db.Uuid
  inventoryManaged           Boolean @default(false) @map("inventory_managed")
  warehouse                  InventoryWarehouse? @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  inventoryReservations      InventoryReservation[]
  inventoryMovements         InventoryMovement[]
  version                    Int       @default(1)
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  status           OrderStatus                  @relation(fields: [statusKey], references: [key], onDelete: Restrict)
  customer         SiigoCustomer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  repartidor       Repartidor?                  @relation(fields: [repartidorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items            SalesOrderItem[]
  statusHistory    SalesOrderStatusHistory[]
  itemPriceHistory SalesOrderItemPriceHistory[]
  siigoInvoice     SalesOrderSiigoInvoice?
  payments         SalesOrderPayment[]

  @@index([warehouseId], map: "sales_orders_warehouse_id_idx")
  @@index([statusKey, orderDate])
  @@index([customerId, orderDate])
  @@index([vendedorEmail])
  @@index([repartidorId])
  @@index([createdAt])
  @@map("sales_orders")
}

model Expense {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expenseDate          DateTime @map("expense_date") @db.Date
  category             String   @db.VarChar(64)
  description          String   @db.VarChar(250)
  providerId           String   @map("provider_id") @db.Uuid
  providerNameSnapshot String   @map("provider_name_snapshot")
  providerRfcSnapshot  String?  @map("provider_rfc_snapshot")
  providerPayload      Json     @map("provider_payload") @db.JsonB
  currencyCode         String   @map("currency_code") @db.VarChar(3)
  exchangeRate         Decimal  @map("exchange_rate") @db.Decimal(20, 6)
  amount               Decimal  @db.Decimal(20, 2)
  paymentMethod        String   @map("payment_method") @db.VarChar(32)
  notes                String?
  createdByUserId      String?  @map("created_by_user_id") @db.Uuid
  createdByName        String   @map("created_by_name")
  createdByEmail       String   @map("created_by_email")
  createdByRole        String   @map("created_by_role") @db.VarChar(32)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  purchasePaymentId String? @unique @map("purchase_payment_id") @db.Uuid
  purchasePayment PurchasePayment? @relation(fields: [purchasePaymentId], references: [id], onDelete: Restrict)

  provider      SiigoCustomer @relation(fields: [providerId], references: [id], onDelete: Restrict)
  createdByUser AppUser?      @relation(fields: [createdByUserId], references: [userId], onDelete: SetNull)

  @@index([expenseDate, createdAt])
  @@index([category, expenseDate])
  @@index([providerId, expenseDate])
  @@index([createdByUserId])
  @@map("expenses")
}

model SalesOrderSiigoInvoice {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String   @unique @map("order_id") @db.Uuid
  status           String   @db.VarChar(16)
  siigoInvoiceId   String?  @unique @map("siigo_invoice_id") @db.Uuid
  siigoInvoiceName String?  @map("siigo_invoice_name")
  documentTypeId   Int      @map("document_type_id")
  sellerId         Int      @map("seller_id")
  paymentTypeId    Int      @map("payment_type_id")
  costCenterId     Int?     @map("cost_center_id")
  warehouseId      Int?     @map("warehouse_id")
  invoiceNumber    Int?     @map("invoice_number")
  useCfdi          String   @map("use_cfdi") @db.VarChar(8)
  paymentMethod    String   @map("payment_method") @db.VarChar(3)
  invoiceDate      DateTime @map("invoice_date") @db.Date
  dueDate          DateTime @map("due_date") @db.Date
  total            Decimal  @db.Decimal(20, 2)
  lastError        String?  @map("last_error")
  rawPayload       Json?    @map("raw_payload") @db.JsonB
  createdByName    String   @map("created_by_name")
  createdByEmail   String   @map("created_by_email")
  createdByRole    String   @map("created_by_role") @db.VarChar(32)
  requestedAt      DateTime @default(now()) @map("requested_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, requestedAt])
  @@map("sales_order_siigo_invoices")
}

model SalesOrderPayment {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId           String   @unique @default(dbgenerated("gen_random_uuid()")) @map("request_id") @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  provider            String   @default("local") @db.VarChar(32)
  externalStatus      String   @default("not_applicable") @map("external_status") @db.VarChar(24)
  externalError       String?  @map("external_error")
  paymentMethod       String   @map("payment_method") @db.VarChar(32)
  amount              Decimal  @db.Decimal(20, 2)
  currencyCode        String   @default("MXN") @map("currency_code") @db.VarChar(3)
  paymentDate         DateTime @map("payment_date") @db.Date
  reference           String?
  observations        String?
  siigoVoucherId      String?  @unique @map("siigo_voucher_id") @db.Uuid
  siigoVoucherName    String?  @map("siigo_voucher_name")
  siigoInvoiceId      String?  @map("siigo_invoice_id") @db.Uuid
  siigoInvoiceName    String?  @map("siigo_invoice_name")
  siigoDocumentTypeId Int?     @map("siigo_document_type_id")
  siigoPaymentTypeId  Int?     @map("siigo_payment_type_id")
  siigoCostCenterId   Int?     @map("siigo_cost_center_id")
  siigoCfdiCode       String?  @map("siigo_cfdi_code") @db.VarChar(8)
  siigoPaymentMethod  String?  @map("siigo_payment_method") @db.VarChar(3)
  siigoQuote          Int?     @map("siigo_quote")
  externalPayload     Json?    @map("external_payload") @db.JsonB
  createdByName       String   @map("created_by_name")
  createdByEmail      String   @map("created_by_email")
  createdByRole       String   @map("created_by_role") @db.VarChar(32)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([siigoInvoiceId])
  @@index([provider, externalStatus])
  @@map("sales_order_payments")
}

model SalesOrderItem {
  id                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                    String   @map("order_id") @db.Uuid
  position                   Int
  productId                  String   @map("product_id") @db.Uuid
  productCodeSnapshot        String   @map("product_code_snapshot")
  productNameSnapshot        String   @map("product_name_snapshot")
  productDescriptionSnapshot String?  @map("product_description_snapshot")
  productReferenceSnapshot   String?  @map("product_reference_snapshot")
  unitCodeSnapshot           String?  @map("unit_code_snapshot")
  unitNameSnapshot           String?  @map("unit_name_snapshot")
  productPayload             Json     @map("product_payload") @db.JsonB
  quantity                   Decimal  @db.Decimal(20, 6)
  unitPrice                  Decimal  @map("unit_price") @db.Decimal(20, 6)
  taxIncluded                Boolean  @default(false) @map("tax_included")
  discountType               String   @default("porcentaje") @map("discount_type") @db.VarChar(16)
  discountValue              Decimal  @default(0) @map("discount_value") @db.Decimal(20, 6)
  discountPercentage         Decimal  @default(0) @map("discount_percentage") @db.Decimal(9, 6)
  discountAmount             Decimal  @default(0) @map("discount_amount") @db.Decimal(20, 6)
  taxPayload                 Json     @map("tax_payload") @db.JsonB
  subtotal                   Decimal  @db.Decimal(20, 6)
  taxAmount                  Decimal  @default(0) @map("tax_amount") @db.Decimal(20, 6)
  total                      Decimal  @db.Decimal(20, 6)
  observations               String?  @map("observations")
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order        SalesOrder                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      SiigoProduct                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  priceHistory SalesOrderItemPriceHistory[]

  @@unique([orderId, position])
  @@index([productId])
  @@map("sales_order_items")
}

model SalesOrderItemPriceHistory {
  id             BigInt   @id @default(autoincrement())
  orderItemId    String   @map("order_item_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  previousPrice  Decimal  @map("previous_price") @db.Decimal(20, 6)
  newPrice       Decimal  @map("new_price") @db.Decimal(20, 6)
  note           String?
  changedByName  String   @map("changed_by_name")
  changedByEmail String   @map("changed_by_email")
  changedByRole  String   @map("changed_by_role") @db.VarChar(32)
  changedAt      DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  orderItem SalesOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  order     SalesOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderItemId, changedAt])
  @@index([orderId, changedAt])
  @@map("sales_order_item_price_history")
}

model SalesOrderStatusHistory {
  id             BigInt   @id @default(autoincrement())
  orderId        String   @map("order_id") @db.Uuid
  fromStatusKey  String?  @map("from_status_key") @db.VarChar(32)
  toStatusKey    String   @map("to_status_key") @db.VarChar(32)
  note           String?
  changedByName  String   @map("changed_by_name")
  changedByEmail String   @map("changed_by_email")
  changedByRole  String   @map("changed_by_role") @db.VarChar(32)
  changedAt      DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  order      SalesOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus? @relation("status_history_from", fields: [fromStatusKey], references: [key], onDelete: Restrict)
  toStatus   OrderStatus  @relation("status_history_to", fields: [toStatusKey], references: [key], onDelete: Restrict)

  @@index([orderId, changedAt])
  @@map("sales_order_status_history")
}

model ProductImage {
  productId        String   @id @map("product_id") @db.Uuid
  storagePath      String   @unique @map("storage_path")
  contentType      String   @map("content_type") @db.VarChar(32)
  sizeBytes        Int      @map("size_bytes")
  uploadedByUserId String?  @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  uploadedByUser AppUser? @relation(fields: [uploadedByUserId], references: [userId], onDelete: SetNull)

  @@index([uploadedByUserId])
  @@map("product_images")
}


model PurchaseOrder {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  folio Int @unique @default(autoincrement())
  status String @default("borrador") @db.VarChar(20)
  version Int @default(1)
  providerId String @map("provider_id") @db.Uuid
  providerName String @map("provider_name")
  providerRfc String? @map("provider_rfc")
  providerPayload Json @map("provider_payload") @db.JsonB
  date DateTime @db.Date
  currencyCode String @map("currency_code") @db.VarChar(3)
  total Decimal @db.Decimal(20, 2)
  notes String
  createdBy String @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  provider SiigoCustomer @relation(fields: [providerId], references: [id], onDelete: Restrict)
  items PurchaseItem[]
  receipts PurchaseReceipt[]
  invoices PurchaseInvoice[]
  events PurchaseEvent[]
  @@index([providerId, date])
  @@index([status, date])
  @@map("purchase_orders")
}

model PurchaseItem {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId String @map("order_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  position Int
  code String
  name String
  productPayload Json @map("product_payload") @db.JsonB
  quantity Decimal @db.Decimal(20, 6)
  unitCost Decimal @map("unit_cost") @db.Decimal(20, 6)
  total Decimal @db.Decimal(20, 2)
  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product SiigoProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  receipts PurchaseReceiptItem[]
  @@unique([orderId, position])
  @@index([productId])
  @@map("purchase_items")
}

model PurchaseReceipt {
  warehouseId String? @map("warehouse_id") @db.Uuid
  warehouse InventoryWarehouse? @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  inventoryMovements InventoryMovement[]
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId String @map("order_id") @db.Uuid
  date DateTime @db.Date
  createdBy String @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  voidedAt DateTime? @map("voided_at") @db.Timestamptz(6)
  voidReason String? @map("void_reason")
  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items PurchaseReceiptItem[]
  @@index([orderId])
  @@index([warehouseId], map: "purchase_receipts_warehouse_id_idx")
  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  receiptId String @map("receipt_id") @db.Uuid
  itemId String @map("item_id") @db.Uuid
  quantity Decimal @db.Decimal(20, 6)
  receipt PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  item PurchaseItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  @@id([receiptId, itemId])
  @@index([itemId])
  @@map("purchase_receipt_items")
}

model PurchaseInvoice {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId String @map("order_id") @db.Uuid
  folio String @db.VarChar(100)
  date DateTime @db.Date
  dueDate DateTime @map("due_date") @db.Date
  amount Decimal @db.Decimal(20, 2)
  createdBy String @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  voidedAt DateTime? @map("voided_at") @db.Timestamptz(6)
  voidReason String? @map("void_reason")
  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payments PurchasePayment[]
  @@index([orderId])
  @@index([dueDate])
  @@map("purchase_invoices")
}

model PurchasePayment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId String @map("invoice_id") @db.Uuid
  date DateTime @db.Date
  amount Decimal @db.Decimal(20, 2)
  exchangeRate Decimal @map("exchange_rate") @db.Decimal(20, 6)
  method String @db.VarChar(32)
  createdBy String @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  voidedAt DateTime? @map("voided_at") @db.Timestamptz(6)
  voidReason String? @map("void_reason")
  invoice PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  expense Expense?
  @@index([invoiceId])
  @@map("purchase_payments")
}

model PurchaseEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId String @unique @map("request_id") @db.Uuid
  requestHash String @map("request_hash")
  orderId String @map("order_id") @db.Uuid
  action String @db.VarChar(32)
  detail Json @db.JsonB
  createdBy String @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([orderId, createdAt])
  @@map("purchase_events")
}

model InventorySettings {
  id        Int       @id @default(1)
  enabledAt DateTime? @map("enabled_at") @db.Timestamptz(6)
  version   Int       @default(1)

  @@map("inventory_settings")
}

model InventoryWarehouse {
  id           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String                  @unique @db.VarChar(64)
  name         String                  @db.VarChar(200)
  address      String?
  active       Boolean                 @default(true)
  version      Int                     @default(1)
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  balances     InventoryBalance[]
  reservations InventoryReservation[]
  lines        InventoryMovementLine[]
  counts       InventoryCount[]
  orders       SalesOrder[]
  receipts     PurchaseReceipt[]

  @@map("inventory_warehouses")
}

model InventoryProduct {
  productId String       @id @map("product_id") @db.Uuid
  enabled   Boolean
  version   Int          @default(1)
  product   SiigoProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("inventory_products")
}

model InventoryBalance {
  warehouseId String             @map("warehouse_id") @db.Uuid
  productId   String             @map("product_id") @db.Uuid
  quantity    Decimal            @default(0) @db.Decimal(20, 6)
  reserved    Decimal            @default(0) @db.Decimal(20, 6)
  minimum     Decimal            @default(0) @db.Decimal(20, 6)
  version     Int                @default(1)
  warehouse   InventoryWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product     SiigoProduct       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([warehouseId, productId])
  @@index([productId])
  @@map("inventory_balances")
}

model InventoryReservation {
  orderId     String             @map("order_id") @db.Uuid
  productId   String             @map("product_id") @db.Uuid
  warehouseId String             @map("warehouse_id") @db.Uuid
  quantity    Decimal            @db.Decimal(20, 6)
  order       SalesOrder         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product     SiigoProduct       @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse   InventoryWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@id([orderId, productId])
  @@index([warehouseId, productId])
  @@index([productId])
  @@map("inventory_reservations")
}

model InventoryMovement {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  folio            Int                     @unique @default(autoincrement())
  type             String                  @db.VarChar(32)
  originKey        String                  @unique @map("origin_key")
  date             DateTime                @db.Date
  reason           String
  actorId          String                  @map("actor_id") @db.Uuid
  actorName        String                  @map("actor_name")
  actorEmail       String                  @map("actor_email")
  actorRole        String                  @map("actor_role")
  orderId          String?                 @map("order_id") @db.Uuid
  receiptId        String?                 @map("receipt_id") @db.Uuid
  reversalOfId     String?                 @unique @map("reversal_of_id") @db.Uuid
  sourceMovementId String?                 @map("source_movement_id") @db.Uuid
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  order            SalesOrder?             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  receipt          PurchaseReceipt?        @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  reversalOf       InventoryMovement?      @relation("inventory_reversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal         InventoryMovement?      @relation("inventory_reversal")
  sourceMovement   InventoryMovement?      @relation("inventory_returns", fields: [sourceMovementId], references: [id], onDelete: Restrict)
  returns          InventoryMovement[]     @relation("inventory_returns")
  lines            InventoryMovementLine[]
  counts           InventoryCount[]

  @@index([orderId])
  @@index([receiptId])
  @@index([sourceMovementId])
  @@index([date, folio])
  @@map("inventory_movements")
}

model InventoryMovementLine {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  movementId    String             @map("movement_id") @db.Uuid
  warehouseId   String             @map("warehouse_id") @db.Uuid
  productId     String             @map("product_id") @db.Uuid
  delta         Decimal            @db.Decimal(20, 6)
  balanceAfter  Decimal            @map("balance_after") @db.Decimal(20, 6)
  productCode   String             @map("product_code")
  productName   String             @map("product_name")
  unitCode      String?            @map("unit_code")
  unitName      String?            @map("unit_name")
  warehouseName String             @map("warehouse_name")
  movement      InventoryMovement  @relation(fields: [movementId], references: [id], onDelete: Restrict)
  warehouse     InventoryWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product       SiigoProduct       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([movementId, warehouseId, productId])
  @@index([warehouseId, productId, movementId])
  @@index([productId])
  @@map("inventory_movement_lines")
}

model InventoryCount {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouseId String               @map("warehouse_id") @db.Uuid
  status      String               @default("borrador") @db.VarChar(32)
  version     Int                  @default(1)
  date        DateTime             @db.Date
  reason      String
  createdBy   String               @map("created_by")
  movementId  String?              @map("movement_id") @db.Uuid
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  warehouse   InventoryWarehouse   @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  movement    InventoryMovement?   @relation(fields: [movementId], references: [id], onDelete: Restrict)
  lines       InventoryCountLine[]

  @@index([warehouseId, status])
  @@index([movementId])
  @@map("inventory_counts")
}

model InventoryCountLine {
  countId     String         @map("count_id") @db.Uuid
  productId   String         @map("product_id") @db.Uuid
  baseVersion Int            @map("base_version")
  expected    Decimal        @db.Decimal(20, 6)
  unitCost    Decimal?       @map("unit_cost") @db.Decimal(20, 6)
  costCurrency String?       @map("cost_currency") @db.VarChar(3)
  counted     Decimal?       @db.Decimal(20, 6)
  count       InventoryCount @relation(fields: [countId], references: [id], onDelete: Restrict)
  product     SiigoProduct   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([countId, productId])
  @@index([productId])
  @@map("inventory_count_lines")
}

model InventoryEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId   String   @unique @map("request_id") @db.Uuid
  requestHash String   @map("request_hash")
  action      String
  actorId     String   @map("actor_id") @db.Uuid
  actorEmail  String   @map("actor_email")
  detail      Json     @db.JsonB
  result      Json     @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("inventory_events")
}
